7. Phase 2: The editable menu
Goal: the owner changes dishes, prices, photos, extras and availability from a phone, with no developer, and no edit can ever corrupt an old order.
Risks blocked: a typed price becoming the wrong kobo amount, a price change rewriting past orders, a deleted dish breaking order history, two people overwriting each other, a sold-out dish still being ordered, uploads that crash or leak, and a stale public menu.
Design rules
• Items move through three states: draft (invisible), published, archived (hidden, kept). Items are never hard-deleted once an order references them. The foreign key is RESTRICT.
• Every edit saves a version row (before and after) and one tap restores the previous version.
• A price change shows a confirmation: 'Jollof Rice ₦3,500.00 to ₦4,000.00. Applies to new orders only.' Past orders keep their snapshot.
• 'Sold out today' is one tap and clears itself at 00:00 Africa/Lagos. Permanent unavailability is a separate toggle.
• Optimistic locking: each row has a version integer. A stale save is rejected with 'Someone else changed this item, reload'.
• Staff can toggle availability only. Owner edits everything (decision 2).
• Reordering works with up and down buttons, not only drag-and-drop, because drag fails on cheap phones.
Schema (kobo only)
create table menu_categories (
  id uuid primary key default gen_random_uuid(),
  name text not null check (length(name) between 1 and 60),
  sort_order int not null default 0,
  is_visible boolean not null default true,
  version int not null default 1
);
create unique index menu_categories_name_uq on menu_categories (lower(name));

create table menu_items (
  id uuid primary key default gen_random_uuid(),
  sku text unique,                       -- stable key for CSV re-import
  category_id uuid not null references menu_categories(id) on delete restrict,
  name text not null check (length(name) between 1 and 80),
  description text check (length(description) <= 500),
  price_kobo bigint not null check (price_kobo >= 0 and price_kobo <= 100000000000),
  portion_label text,                    -- e.g. 'Serves 1' (owner-supplied)
  allergens text[] not null default '{}',
  image_path text,
  image_alt text,
  status text not null default 'draft' check (status in ('draft','published','archived')),
  is_available boolean not null default true,
  sold_out_until timestamptz,            -- set to next 00:00 Lagos by 'Sold out today'
  is_featured boolean not null default false,
  sort_order int not null default 0,
  version int not null default 1,
  updated_by uuid references profiles(id),
  updated_at timestamptz not null default now()
);
create unique index menu_items_cat_name_uq on menu_items (category_id, lower(name));

create table menu_option_groups (
  id uuid primary key default gen_random_uuid(),
  item_id uuid not null references menu_items(id) on delete cascade,
  name text not null,                    -- e.g. 'Protein', 'Extras'
  min_select int not null default 0,
  max_select int not null default 1,
  check (max_select >= min_select)
);

create table menu_options (
  id uuid primary key default gen_random_uuid(),
  group_id uuid not null references menu_option_groups(id) on delete cascade,
  name text not null,
  price_delta_kobo bigint not null default 0 check (price_delta_kobo >= 0),
  is_available boolean not null default true,
  sort_order int not null default 0
);

create table menu_item_versions (
  id bigint generated always as identity primary key,
  item_id uuid not null references menu_items(id),
  version int not null,
  snapshot jsonb not null,
  changed_by uuid references profiles(id),
  changed_at timestamptz not null default now()
);
